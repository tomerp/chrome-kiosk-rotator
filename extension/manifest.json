{
  "manifest_version": 3,
  "name": "Kiosk Rotator",
  "version": "0.3.1",
  "minimum_chrome_version": "120",
  "description": "Rotate loaded website tabs on dashboard and kiosk displays, with a countdown and keyboard controls.",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kiosk Rotator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

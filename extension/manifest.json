{
  "manifest_version": 3,
  "name": "Chrome Kiosk Rotator",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Rotate loaded website tabs on dashboard and kiosk displays, with a countdown and keyboard controls.",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chrome Kiosk Rotator",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
